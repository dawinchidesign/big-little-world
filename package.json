{
  "name": "great-little-world",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "art:build": "node scripts/build-visual-assets.mjs",
    "build": "vite build && node scripts/package.mjs",
    "test": "node --test tests/*.test.js",
    "test:runtime": "node tests/runtime.mjs",
    "test:offline": "node tests/runtime.mjs --offline",
    "test:recovery": "node tests/runtime.mjs --missing-asset && node tests/runtime.mjs --no-storage",
    "release:archive": "node scripts/archive.mjs"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "howler": "2.2.4",
    "i18next": "25.6.0",
    "phaser": "3.90.0",
    "simplex-noise": "4.0.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "maxrects-packer": "3.0.0",
    "vite": "7.1.9"
  }
}
