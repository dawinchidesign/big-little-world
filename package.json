{
  "name": "great-little-world",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "art:build": "node scripts/build-visual-assets.mjs",
    "build": "vite build && node scripts/package.mjs",
    "test": "node --test tests/*.test.js",
    "test:runtime": "node tests/runtime.mjs",
    "test:offline": "node tests/runtime.mjs --offline",
    "test:recovery": "node tests/runtime.mjs --missing-asset && node tests/runtime.mjs --no-storage",
    "test:browser": "node tests/browser.mjs",
    "release:archive": "node scripts/archive.mjs",
    "art:horizon": "node scripts/build-horizon-assets.mjs",
    "test:expeditions": "node tests/runtime.mjs --expeditions",
    "test:browser-expeditions": "node tests/browser-expedition.mjs",
    "voice:script": "node scripts/build-voice-script.mjs",
    "test:browser-speech": "node tests/browser-speech.mjs",
    "voice:clips": "python scripts/build-voice-clips.py",
    "voice:audit": "python scripts/audit-voice-clips.py"
  },
  "dependencies": {
    "easystarjs": "0.4.4",
    "gsap": "3.13.0",
    "howler": "2.2.4",
    "i18next": "25.6.0",
    "phaser": "3.90.0",
    "rbush": "4.0.1",
    "simplex-noise": "4.0.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "maxrects-packer": "3.0.0",
    "playwright": "1.64.1",
    "vite": "7.3.7"
  }
}
